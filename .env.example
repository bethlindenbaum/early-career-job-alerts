PORT=4173
PUBLIC_URL=http://localhost:4173

# Immediate SMS alerts (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Daily email digest (Resend)
RESEND_API_KEY=
EMAIL_FROM=First Look Jobs <alerts@example.com>

# 15 minutes by default. Set to 0 to disable the background scan.
SCAN_INTERVAL_MINUTES=15
